<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>lk.sliit.nutricare</groupId>
    <artifactId>nutricare-parent</artifactId>
    <version>1.0.0</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>nutricare-application</artifactId>
  <name>NutriCare Application</name>

  <dependencies>
    <dependency><groupId>lk.sliit.nutricare</groupId><artifactId>user-access</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>lk.sliit.nutricare</groupId><artifactId>appointment-billing</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>lk.sliit.nutricare</groupId><artifactId>health-check</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>lk.sliit.nutricare</groupId><artifactId>diet-progress</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>lk.sliit.nutricare</groupId><artifactId>messaging-reminders</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>lk.sliit.nutricare</groupId><artifactId>feedback-analytics</artifactId><version>${project.version}</version></dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>lk.sliit.nutricare.NutriCareApplication</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
