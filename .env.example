# Database
DB_URL=jdbc:mysql://localhost:3306/nutricare?createDatabaseIfNotExist=true&serverTimezone=Asia/Colombo
DB_USERNAME=
DB_PASSWORD=

# Authentication
JWT_SECRET=

# Frontend
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
VITE_API_BASE_URL=/api/v1

# Gemini AI (optional — used for NutriGuide patient assistant)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# SMTP email. Keep MAIL_LIVE_ENABLED=false until these values are configured.
MAIL_LIVE_ENABLED=false
DEMO_NOTIFICATIONS=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
